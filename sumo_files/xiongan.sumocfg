<configuration>
    <input>
        <net-file value="xiongan.net.xml"/>
        <route-files value="xiongan.rou.xml"/>
        <additional-files value="signal.add.xml,detectors.add.xml"/>
    </input>
    <output>
        <tripinfo-output value="tripinfo.xml"/>
        <emission-output value="emissions.xml"/>
        <summary-output value="summary.xml"/>
        <queue-output value="queues.xml"/>
    </output>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
    <gui_only>
        <gui-settings-file value="view.settings.xml"/>
    </gui_only>
</configuration>